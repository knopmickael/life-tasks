{
  "name": "life-tasks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node --experimental-sqlite --import tsx --watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --experimental-sqlite --import tsx server/index.ts",
    "test": "node --experimental-sqlite --import tsx --test tests/*.test.ts"
  },
  "dependencies": { "react": "^19.0.0", "react-dom": "^19.0.0", "fastify": "^5.6.0", "@fastify/static": "^10.1.11", "lucide-react": "^0.468.0" },
  "devDependencies": { "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@types/node": "^22.10.0", "typescript": "~5.7.2", "vite": "^6.4.1", "@vitejs/plugin-react": "^4.3.4", "tsx": "^4.19.2", "concurrently": "^9.1.0" }
}
